# Dependencies
/vendor/
/node_modules/

# Build artefacts
*.zip
/dist/

# Editor / OS
.DS_Store
.idea/
.vscode/
*.log

# Test artefacts
.phpunit.result.cache

# Generated by `composer install` during local test runs; this project
# deliberately resolves dev deps fresh in CI.
/composer.lock

# Scratch directories used by local tooling (test environments, i18n probes).
# Not merely tidiness: bin/build-zip.sh rsyncs the working tree and only skips
# what is gitignored, so anything left lying here ships inside the release zip.
/.tmp-*/
